{
  "info": {
    "_postman_id": "c1f77d61-39a1-4d32-9cb4-8a4db95c64a7",
    "name": "Lanka Workforce Solutions - Employee Complaint Management & Attendance Security",
    "description": "Comprehensive Postman test collection for FR6 Employee Complaint Management and Attendance Clock In/Out Endpoint Security.\n\nModules covered:\n1. Employee OTP/JWT login\n2. Grievance submission with status PENDING\n3. Employee view own complaints (IDOR safe)\n4. Individual complaint inspection\n5. HR Manager login\n6. HR Manager view and filtering of complaints\n7. HR Manager status updates (IN_PROGRESS, RESOLVED, REJECTED)\n8. HR Manager official response recording\n9. Missing required field validation (400 Bad Request)\n10. Unauthorized role access enforcement (403 Forbidden)\n11. Anti-IDOR employee cross-access rejection (403 Forbidden)\n12. Manual Clock In / Clock Out endpoint rejection for employees (403 Forbidden)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api",
      "type": "string"
    },
    {
      "key": "employeeToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "hrToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "unauthorizedToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "employeeEmail",
      "value": "empA@lws.lk",
      "type": "string"
    },
    {
      "key": "employeePassword",
      "value": "Pass123",
      "type": "string"
    },
    {
      "key": "hrEmail",
      "value": "hr.manager@lws.lk",
      "type": "string"
    },
    {
      "key": "hrPassword",
      "value": "Pass123",
      "type": "string"
    },
    {
      "key": "unauthorizedEmail",
      "value": "it.coord@lws.lk",
      "type": "string"
    },
    {
      "key": "unauthorizedPassword",
      "value": "Pass123",
      "type": "string"
    },
    {
      "key": "complaintId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "otherEmployeeComplaintId",
      "value": "999",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Employee Login (OTP / JWT Flow)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"usernameOrEmail\": \"{{employeeEmail}}\",\n  \"password\": \"{{employeePassword}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        },
        "description": "Authenticates an employee using the Lanka Workforce Solutions JWT system. Saves the returned bearer token into {{employeeToken}}."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "var jsonData = pm.response.json();",
              "if (jsonData.token || jsonData.accessToken) {",
              "    var token = jsonData.token || jsonData.accessToken;",
              "    pm.collectionVariables.set('employeeToken', token);",
              "    pm.environment.set('employeeToken', token);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Create Complaint (Employee)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{employeeToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Unscheduled Overtime Discrepancy\",\n  \"category\": \"Salary / Payroll\",\n  \"description\": \"Overtime hours worked during the site transition last weekend were omitted from the monthly payroll calculation sheet.\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/compliance/complaints",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "compliance",
            "complaints"
          ]
        },
        "description": "Submits a new confidential employee grievance. Server sets initial status to PENDING and links to authenticated employee profile."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 201 Created', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.expect(jsonData.status).to.eql('PENDING');",
              "pm.expect(jsonData.complaintCode).to.not.be.empty;",
              "if (jsonData.id) {",
              "    pm.collectionVariables.set('complaintId', jsonData.id.toString());",
              "    pm.environment.set('complaintId', jsonData.id.toString());",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Get Employee Complaints (Self-Service)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{employeeToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/compliance/complaints/my",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "compliance",
            "complaints",
            "my"
          ]
        },
        "description": "Retrieves the authenticated employee's list of complaints. Strictly isolated to their own records."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.expect(Array.isArray(jsonData)).to.be.true;"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Get Individual Complaint (Employee Self-Service)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{employeeToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/compliance/complaints/my/{{complaintId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "compliance",
            "complaints",
            "my",
            "{{complaintId}}"
          ]
        },
        "description": "Fetches full details of a complaint owned by the authenticated employee."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.expect(jsonData.id.toString()).to.eql(pm.collectionVariables.get('complaintId'));"
            ]
          }
        }
      ]
    },
    {
      "name": "5. HR Manager Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"usernameOrEmail\": \"{{hrEmail}}\",\n  \"password\": \"{{hrPassword}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        },
        "description": "Authenticates HR Manager and saves bearer token into {{hrToken}}."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "var jsonData = pm.response.json();",
              "var token = jsonData.token || jsonData.accessToken;",
              "pm.collectionVariables.set('hrToken', token);",
              "pm.environment.set('hrToken', token);"
            ]
          }
        }
      ]
    },
    {
      "name": "6. Get All Complaints (HR Manager)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{hrToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/compliance/complaints?status=PENDING&category=Salary / Payroll",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "compliance",
            "complaints"
          ],
          "query": [
            {
              "key": "status",
              "value": "PENDING"
            },
            {
              "key": "category",
              "value": "Salary / Payroll"
            }
          ]
        },
        "description": "Retrieves all complaints across the organization for HR review with filtering options."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.expect(Array.isArray(jsonData)).to.be.true;"
            ]
          }
        }
      ]
    },
    {
      "name": "7. Update Complaint Status (HR Manager)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{hrToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"IN_PROGRESS\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/compliance/complaints/{{complaintId}}/status",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "compliance",
            "complaints",
            "{{complaintId}}",
            "status"
          ]
        },
        "description": "Updates grievance lifecycle status to IN_PROGRESS indicating investigation is underway."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.expect(jsonData.status).to.eql('IN_PROGRESS');"
            ]
          }
        }
      ]
    },
    {
      "name": "8. Submit Official HR Response (HR Manager)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{hrToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"RESOLVED\",\n  \"adminResponse\": \"HR Payroll review confirmed that Saturday shift overtime was omitted due to delayed supervisor sign-off. The 4 hours have been added to the arrears adjustment and will reflect in this month's payslip.\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/compliance/complaints/{{complaintId}}/response",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "compliance",
            "complaints",
            "{{complaintId}}",
            "response"
          ]
        },
        "description": "Records an official HR response and marks the complaint as RESOLVED. Notifies the submitting employee."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.expect(jsonData.status).to.eql('RESOLVED');",
              "pm.expect(jsonData.adminResponse).to.not.be.empty;",
              "pm.expect(jsonData.resolvedAt).to.not.be.null;"
            ]
          }
        }
      ]
    },
    {
      "name": "9. Validation: Test Missing Required Fields (400 Bad Request)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{employeeToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"\",\n  \"category\": \"\",\n  \"description\": \"\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/compliance/complaints",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "compliance",
            "complaints"
          ]
        },
        "description": "Verifies server-side validation rejects empty or missing required complaint fields with HTTP 400 Bad Request."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 400 Bad Request', function () {",
              "    pm.response.to.have.status(400);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "10. Security: Test Unauthorized Role Access (403 Forbidden)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{unauthorizedToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/compliance/complaints",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "compliance",
            "complaints"
          ]
        },
        "description": "Verifies confidential HR complaint management is forbidden to unauthorized roles like IT_COORDINATOR, FINANCE_EXECUTIVE, or EMPLOYEE."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 403 Forbidden', function () {",
              "    pm.response.to.have.status(403);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "11. Security IDOR: Verify Employee Cannot Access Another Employee's Complaint (403 Forbidden)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{employeeToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/compliance/complaints/my/{{otherEmployeeComplaintId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "compliance",
            "complaints",
            "my",
            "{{otherEmployeeComplaintId}}"
          ]
        },
        "description": "Verifies an employee attempting to access another staff member's grievance directly by ID is rejected with 403 Forbidden."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 403 Forbidden', function () {",
              "    pm.response.to.have.status(403);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "12. Security: Verify Clock In/Out Endpoints Reject Manual Employee Requests (403 Forbidden)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{employeeToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"notes\": \"Direct Postman attempt to manually clock in\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/attendance/check-in",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "attendance",
            "check-in"
          ]
        },
        "description": "Verifies that direct manual Clock In / Clock Out calls from employees via HTTP/Postman are rejected with 403 Forbidden."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 403 Forbidden', function () {",
              "    pm.response.to.have.status(403);",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
